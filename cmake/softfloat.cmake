# Berkeley SoftFloat Release 3e — used only for the portable x87 arithmetic backend.
# Specialize for 8086-SSE so NaN propagation matches Intel/Watcom hosts on every CPU.
include(FetchContent)
FetchContent_Declare(berkeley_softfloat
  URL https://codeload.github.com/ucb-bar/berkeley-softfloat-3/tar.gz/0a5ad290c6b287f6605bb99a35ad0842c1e61aa5
  URL_HASH SHA256=b646bbef1883c8b50920ec3414307327a599818a4f72c5fc36629f9d6c9052bd
)
# Upstream ships Makefiles only; populate without add_subdirectory.
if(POLICY CMP0169)
  cmake_policy(SET CMP0169 OLD)
endif()
FetchContent_GetProperties(berkeley_softfloat)
if(NOT berkeley_softfloat_POPULATED)
  FetchContent_Populate(berkeley_softfloat)
endif()

set(_tfx_softfloat_specialize 8086-SSE)
set(_tfx_softfloat_platform_dir "${CMAKE_CURRENT_BINARY_DIR}/softfloat_platform")
file(MAKE_DIRECTORY "${_tfx_softfloat_platform_dir}")
file(WRITE "${_tfx_softfloat_platform_dir}/platform.h" [=[
/* Generated for TFX SoftFloat builds (MAME/Bochs-compatible). */
#define LITTLEENDIAN 1
#define INLINE static inline
#define SOFTFLOAT_BUILTIN_CLZ 1
#define SOFTFLOAT_INTRINSIC_INT128 1
#include "opts-GCC.h"
]=])

